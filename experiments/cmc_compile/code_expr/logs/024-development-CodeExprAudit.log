cm_layout_call_cons_length
     : forall (policy : cm_lookup_policy) (p : cm_program)
         (fid pc temp callee : BinNums.Z) (arg : cm_expr)
         (args : list cm_expr) (ty : cm_type),
       cm_rvalue_code_count policy p fid (CMCallE callee (arg :: args) ty) =
       BinInt.Z.add (cm_rvalue_code_count policy p fid arg)
         (Zcomplements.Zlength
            (cm_temp_store_code policy p fid temp ++
             cm_emit_args_store policy p fid
               (BinInt.Z.add
                  (BinInt.Z.add pc (cm_rvalue_code_count policy p fid arg))
                  (BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH))))
               (BinInt.Z.add temp (BinNums.Zpos BinNums.xH))
               (BinInt.Z.add temp (Zcomplements.Zlength (arg :: args))) args ++
             cm_emit_args_reload policy p fid temp (arg :: args) ++
             TVMInst TVMCallOp (cm_function_pc policy p callee) :: nil))
