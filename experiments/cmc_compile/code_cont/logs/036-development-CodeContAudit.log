cm_c_while_layout_step
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (ctl : cm_control)
         (st : cm_src_state) (guard : cm_expr) (body : cm_stmt)
         (env : BinNums.Z -> BinNums.Z -> cm_value)
         (regions : list cm_region)
         (loop_start loop_end pc temp b c owner ob oc : BinNums.Z)
         (tail : list cm_acursor) (spills : list cm_spill)
         (saved : list cm_spill_frame) (calls : list cm_call_sim_frame),
       let phase := CAWhileBodyP guard body env regions loop_start loop_end
         in
       let ann :=
         CMAnnotation pc temp b c (CMACursor phase owner ob oc :: tail)
           spills saved calls in
       cm_control_kind ctl <>
       BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)) ->
       cm_control_kind ctl <>
       BinNums.Zpos (BinNums.xI (BinNums.xO BinNums.xH)) ->
       loop_end =
       BinInt.Z.add
         (BinInt.Z.add
            (BinInt.Z.add
               (BinInt.Z.add loop_start
                  (cm_rvalue_code_count (cm_source_function_policy sp) p fid
                     guard)) (BinNums.Zpos BinNums.xH))
            (cm_stmt_code_count (cm_source_function_policy sp) p fid body))
         (BinNums.Zpos BinNums.xH) ->
       cm_task_layout sp ap p
         (CMCTask p fid ctl st (cm_cursor_frames (cm_ann_cursors ann))) ann ->
       cm_task_layout sp ap p
         (cm_capply sp p fid (cm_phase_frame phase) ctl st
            (cm_cursor_frames tail))
         (cm_update_annotation (cm_update_c sp ap p fid ctl st ann phase))
