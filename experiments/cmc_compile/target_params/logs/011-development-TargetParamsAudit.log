     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (values : list cm_value) 
         (index : BinNums.Z) (a b : cm_src_state)
         (address : BinNums.Z -> BinNums.Z) (finish : BinNums.Z),
       (forall j : BinNums.Z,
        BinInt.Z.le index j /\
        BinInt.Z.lt j (BinInt.Z.add index (Zcomplements.Zlength values)) ->
        cm_value_number a
          (cm_state_env a (BinNums.Zpos (BinNums.xO BinNums.xH)) j) =
        address j /\
        BinInt.Z.add (address j)
          (cm_store_width
             (cm_slot_ty
                (cm_source_slot_at sp j
                   (cm_function_params (cm_source_function_at sp fid p))))) =
        address (BinInt.Z.add j (BinNums.Zpos BinNums.xH)) /\
        BinInt.Z.le (address (BinInt.Z.add j (BinNums.Zpos BinNums.xH)))
          finish) ->
       cm_state_pending_eq a b (address index) finish ->
       cm_state_pending_eq (cm_store_params sp p fid values index a)
         (cm_store_params sp p fid values index b)
         (address (BinInt.Z.add index (Zcomplements.Zlength values))) finish
