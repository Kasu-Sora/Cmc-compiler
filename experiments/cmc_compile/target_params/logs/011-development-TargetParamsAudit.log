cm_call_parameter_disjoint
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (st : cm_src_state) (i j : BinNums.Z),
       cm_function_wf (cm_source_function_policy sp) p
         (cm_source_function_at sp fid p) ->
       cm_frame_segment (cm_source_function_policy sp) p fid
         (BinInt.Z.sub (cm_state_fp st)
            (cm_frame_size (cm_program_structs p)
               (cm_source_function_at sp fid p))) 
         (cm_state_fp st) ->
       BinInt.Z.le BinNums.Z0 i /\ BinInt.Z.lt i j ->
       BinInt.Z.lt j
         (Zcomplements.Zlength
            (cm_function_params (cm_source_function_at sp fid p))) ->
       cm_range_disjoint
         (cm_value_number (cm_call_base_state sp p fid st)
            (cm_state_env (cm_call_base_state sp p fid st)
               (BinNums.Zpos (BinNums.xO BinNums.xH)) i))
         (cm_store_width
            (cm_slot_ty
               (cm_source_slot_at sp i
                  (cm_function_params (cm_source_function_at sp fid p)))))
         (cm_value_number (cm_call_base_state sp p fid st)
            (cm_state_env (cm_call_base_state sp p fid st)
               (BinNums.Zpos (BinNums.xO BinNums.xH)) j))
         (cm_store_width
            (cm_slot_ty
               (cm_source_slot_at sp j
                  (cm_function_params (cm_source_function_at sp fid p)))))
