cm_tagged_write_commutes
     : forall (fa fb : bool) (a aw b bw : BinNums.Z) 
         (na nb : bool) (tags : BinNums.Z -> bool) 
         (x : BinNums.Z),
       (fa = true ->
        aw = BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ->
       (fb = true ->
        bw = BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) ->
       cm_range_disjoint a aw b bw ->
       cm_tagged_write fa a aw na (cm_tagged_write fb b bw nb tags) x =
       cm_tagged_write fb b bw nb (cm_tagged_write fa a aw na tags) x
