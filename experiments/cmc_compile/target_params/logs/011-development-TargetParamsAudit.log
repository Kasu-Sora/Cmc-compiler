cm_store_params_push_disjoint
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (values : list cm_value) 
         (index : BinNums.Z) (st : cm_src_state) (ty : cm_type)
         (ptr value : cm_value),
       (forall j : BinNums.Z,
        BinInt.Z.le index j /\
        BinInt.Z.lt j (BinInt.Z.add index (Zcomplements.Zlength values)) ->
        cm_range_disjoint (cm_value_number st ptr) 
          (cm_store_width ty)
          (cm_value_number st
             (cm_state_env st (BinNums.Zpos (BinNums.xO BinNums.xH)) j))
          (cm_store_width
             (cm_slot_ty
                (cm_source_slot_at sp j
                   (cm_function_params (cm_source_function_at sp fid p)))))) ->
       cm_state_pointwise_eq
         (cm_state_store ty ptr value
            (cm_store_params sp p fid values index st))
         (cm_store_params sp p fid values index
            (cm_state_store ty ptr value st))
