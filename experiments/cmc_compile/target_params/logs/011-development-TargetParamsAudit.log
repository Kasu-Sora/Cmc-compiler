cm_call_params_reverse_forward
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (st : cm_src_state) (values : list cm_value)
         (index : BinNums.Z),
       cm_function_wf (cm_source_function_policy sp) p
         (cm_source_function_at sp fid p) ->
       cm_frame_segment (cm_source_function_policy sp) p fid
         (BinInt.Z.sub (cm_state_fp st)
            (cm_frame_size (cm_program_structs p)
               (cm_source_function_at sp fid p))) 
         (cm_state_fp st) ->
       BinInt.Z.le BinNums.Z0 index ->
       BinInt.Z.le (BinInt.Z.add index (Zcomplements.Zlength values))
         (Zcomplements.Zlength
            (cm_function_params (cm_source_function_at sp fid p))) ->
       cm_state_pointwise_eq
         (cm_store_params_reverse sp p fid values index
            (cm_call_pending_base sp p fid st))
         (cm_store_params sp p fid values index
            (cm_call_pending_base sp p fid st))
