cm_store_params_tagged_except
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (values : list cm_value) 
         (index : BinNums.Z) (st : cm_src_state)
         (address : BinNums.Z -> BinNums.Z) (finish : BinNums.Z),
       (forall j : BinNums.Z,
        BinInt.Z.le index j /\
        BinInt.Z.lt j (BinInt.Z.add index (Zcomplements.Zlength values)) ->
        cm_value_number st
          (cm_state_env st (BinNums.Zpos (BinNums.xO BinNums.xH)) j) =
        address j /\
        BinInt.Z.add (address j)
          (cm_store_width
             (cm_slot_ty
                (cm_source_slot_at sp j
                   (cm_function_params (cm_source_function_at sp fid p))))) =
        address (BinInt.Z.add j (BinNums.Zpos BinNums.xH)) /\
        (cm_is_pointerb
           (cm_slot_ty
              (cm_source_slot_at sp j
                 (cm_function_params (cm_source_function_at sp fid p)))) =
         true ->
         cm_live_span st (address j)
           (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))) ->
       cm_tagged_span_except st (address index) finish ->
       cm_tagged_span_except (cm_store_params sp p fid values index st)
         (address (BinInt.Z.add index (Zcomplements.Zlength values))) finish
