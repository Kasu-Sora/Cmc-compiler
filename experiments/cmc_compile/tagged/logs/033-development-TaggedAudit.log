cm_tagged_span_clear_extension
     : forall (left right : cm_src_state) (base width : BinNums.Z),
       (forall a : BinNums.Z,
        cm_state_tagged right a =
        cm_clear_tagged (cm_state_tagged left) base width a) ->
       (forall a : BinNums.Z,
        cm_live_address right a ->
        cm_live_address left a \/
        BinInt.Z.le base a /\ BinInt.Z.lt a (BinInt.Z.add base width)) ->
       (forall a : BinNums.Z,
        cm_live_address left a -> cm_live_address right a) ->
       cm_tagged_span_valid left -> cm_tagged_span_valid right
