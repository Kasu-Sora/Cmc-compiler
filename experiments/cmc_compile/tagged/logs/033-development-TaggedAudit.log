cm_pointer_region_witness
     : forall (regions : list cm_region) (ptr : cm_value),
       cm_pointer_region_ok regions ptr true = true ->
       exists r : cm_region,
         List.In r regions /\
         cm_region_gen r = cm_ptr_gen ptr /\
         cm_region_live r = true /\
         cm_region_writable r = true /\
         BinInt.Z.le (cm_region_lo r) (cm_ptr_lo ptr) /\
         BinInt.Z.le (cm_ptr_hi ptr) (cm_region_hi r)
