((fix cm_cursors_coordinate
    (policy : cm_lookup_policy) (p : cm_program)
    (fid temp breakpc continuepc : Z) (cursors : list cm_acursor) {struct
     cursors} : Prop :=
    match cursors with
    | [] => True
    | cursor :: rest =>
        temp =
        match cm_cursor_phase cursor with
        | CABinRP op _ _ _ _ =>
            if if op =? 0 then true else op =? 1
            then cm_cursor_temp cursor
            else cm_cursor_temp cursor + 1
        | CAAssignRP _ _ | CAIndexRP _ _ => cm_cursor_temp cursor + 1
        | CAArgP _ _ _ _ _ _ _ scratch => scratch
        | CACallP _ _ _ _ _ => 0
        | _ => cm_cursor_temp cursor
        end /\
        (match cm_cursor_phase cursor with
         | CAWhileGuardP _ _ _ _ | CAWhileBodyP _ _ _ _ _ _ |
           CACallP _ _ _ _ _ => false
         | _ => true
         end = true ->
         breakpc = cm_cursor_break cursor /\
         continuepc = cm_cursor_continue cursor) /\
        match cm_cursor_phase cursor with
        | CAWhileGuardP guard body start finish =>
            finish =
            start + cm_rvalue_code_count policy p fid guard + 1 +
            cm_stmt_code_count policy p fid body + 1
        | CAWhileBodyP guard body _ _ start finish =>
            breakpc = finish /\
            continuepc = start /\
            finish =
            start + cm_rvalue_code_count policy p fid guard + 1 +
            cm_stmt_code_count policy p fid body + 1
        | _ => True
        end /\
        cm_cursors_coordinate policy p
          match cm_cursor_phase cursor with
          | CACallP caller _ _ _ _ => caller
          | _ => fid
          end (cm_cursor_temp cursor) (cm_cursor_break cursor)
          (cm_cursor_continue cursor) rest
    end) (cm_source_function_policy sp) p fid
