     : forall (obj : tvm_object) (pc : BinNums.Z) 
         (calls : list BinNums.Z) (mem : BinNums.Z -> BinNums.Z)
         (input output : list BinNums.Z) (offset : BinNums.Z)
         (rest : list tvm_inst),
       cm_code_at (tvm_object_code obj) pc
         (cm_fp_relative_address_code offset ++ rest) ->
