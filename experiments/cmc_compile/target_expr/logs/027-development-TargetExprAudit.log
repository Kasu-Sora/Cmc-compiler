cm_target_r_structural_step
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (expr : cm_expr)
         (st : cm_src_state) (ks : list cm_frame) 
         (target : tvm_task) (ann : cm_annotation),
       match expr with
       | CMVarE scope slot _ => cm_binding_array sp p fid scope slot = false
       | CMCallE _ args _ => args <> nil
       | CMConstE _ _ | CMStringE _ _ | CMSizeofE _ _ | CMGetcE _ => False
       | _ => True
       end ->
       cm_task_target_sim (cm_source_function_policy sp) p
         (CMRTask p fid expr st ks) target ann ->
       cm_target_step_result sp ap p (CMRTask p fid expr st ks) target ann
