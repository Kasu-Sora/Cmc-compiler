cm_target_binding_sim
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid scope slot : BinNums.Z) (st : cm_src_state)
         (ann : cm_annotation) (target : tvm_task) 
         (rest : list tvm_inst),
       cm_binding_address_ok sp p fid scope slot st = true ->
       cm_running_target_sim (cm_source_function_policy sp) p fid st nil ann
         target ->
       cm_code_at (cm_model_code (cm_source_function_policy sp) p)
         (cm_ann_pc ann)
         (cm_binding_address_code (cm_source_function_policy sp) p fid scope
            slot ++ rest) ->
       cm_running_target_sim (cm_source_function_policy sp) p fid st
         ((if BinInt.Z.eqb scope BinNums.Z0
           then cm_global_pointer sp p slot
           else cm_state_env st scope slot) :: nil)
         (cm_ann_linear
            (cm_binding_address_code (cm_source_function_policy sp) p fid
               scope slot) ann)
         (tvm_iter
            (cm_code_steps
               (cm_binding_address_code (cm_source_function_policy sp) p fid
                  scope slot)) target)
