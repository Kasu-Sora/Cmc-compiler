cm_string_region_at_nat
     : forall (p : cm_program) (ss : list cm_string_d) 
         (start : BinNums.Z) (i : nat),
       i < length ss ->
       List.In
         (CMRegion
            (cm_string_generation p (BinInt.Z.add start (BinInt.Z.of_nat i)))
            (cm_string_address p (BinInt.Z.add start (BinInt.Z.of_nat i)))
            BinNums.Z0
            (BinInt.Z.add
               (Zcomplements.Zlength
                  (cm_string_bytes
                     (List.nth i ss {| cm_string_bytes := nil |})))
               (BinNums.Zpos BinNums.xH)) false true)
         (cm_string_regions p ss start)
