    (fix cm_cursors_coordinate
       (policy : cm_lookup_policy) (p : cm_program)
       (fid temp breakpc continuepc : Z) (cursors : list cm_acursor) {struct
        cursors} : Prop :=
       match cursors with
       | [] => True
       | cursor :: rest =>
           temp =
           match match cursor with
                 | CMACursor phase _ _ _ => phase
                 end with
           | CABinRP op _ _ _ _ =>
               if if op =? 0 then true else op =? 1
               then match cursor with
                    | CMACursor _ temp0 _ _ => temp0
                    end
               else
                match cursor with
                | CMACursor _ temp0 _ _ => temp0
                end + 1
           | CAAssignRP _ _ | CAIndexRP _ _ =>
               match cursor with
               | CMACursor _ temp0 _ _ => temp0
               end + 1
           | CAArgP _ _ _ _ _ _ _ scratch => scratch
           | CACallP _ _ _ _ _ => 0
           | _ => match cursor with
                  | CMACursor _ temp0 _ _ => temp0
                  end
           end /\
           (match match cursor with
                  | CMACursor phase _ _ _ => phase
                  end with
            | CAWhileGuardP _ _ _ _ | CAWhileBodyP _ _ _ _ _ _ |
              CACallP _ _ _ _ _ => false
            | _ => true
            end = true ->
            breakpc = match cursor with
                      | CMACursor _ _ b _ => b
                      end /\
            continuepc = match cursor with
                         | CMACursor _ _ _ c => c
                         end) /\
           match match cursor with
                 | CMACursor phase _ _ _ => phase
                 end with
           | CAWhileGuardP guard body start finish =>
               finish =
               start + cm_rvalue_code_count policy p fid guard + 1 +
               cm_stmt_code_count policy p fid body + 1
           | CAWhileBodyP guard body _ _ start finish =>
               breakpc = finish /\
               continuepc = start /\
               finish =
               start + cm_rvalue_code_count policy p fid guard + 1 +
               cm_stmt_code_count policy p fid body + 1
           | _ => True
           end /\
           cm_cursors_coordinate policy p
             match
               match cursor with
               | CMACursor phase _ _ _ => phase
               end
             with
             | CACallP caller _ _ _ _ => caller
             | _ => fid
             end match cursor with
                 | CMACursor _ temp0 _ _ => temp0
                 end match cursor with
                     | CMACursor _ _ b _ => b
                     end match cursor with
                         | CMACursor _ _ _ c => c
                         end rest
       end) (cm_source_function_policy sp) p fid pt pb pk rest
