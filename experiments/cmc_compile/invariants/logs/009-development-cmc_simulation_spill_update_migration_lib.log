                  | CMACursor phase _ _ _ => phase
                  end with
            | CAWhileGuardP _ _ _ _ | CAWhileBodyP _ _ _ _ _ _ |
              CACallP _ _ _ _ _ => false
            | _ => true
            end = true ->
            breakpc = match cursor with
                      | CMACursor _ _ b _ => b
                      end /\
            continuepc = match cursor with
                         | CMACursor _ _ _ c => c
                         end) /\
           match match cursor with
                 | CMACursor phase _ _ _ => phase
                 end with
           | CAWhileGuardP guard body start finish =>
               finish =
               start + cm_rvalue_code_count policy p fid guard + 1 +
               cm_stmt_code_count policy p fid body + 1
           | CAWhileBodyP guard body _ _ start finish =>
               breakpc = finish /\
               continuepc = start /\
               finish =
