cm_v_statement_control
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (v : cm_value)
         (st : cm_src_state) (phase : cm_aphase)
         (pc temp b c pt pb pk : BinNums.Z) (rest : list cm_acursor)
         (spills : list cm_spill) (saved : list cm_spill_frame)
         (calls : list cm_call_sim_frame),
       let ann :=
         CMAnnotation pc temp b c (CMACursor phase pt pb pk :: rest) spills
           saved calls in
       cm_task_context_ready
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) ann ->
       cm_task_statement_control
         (cm_vapply sp p fid (cm_phase_frame phase) v st
            (cm_cursor_frames rest))
         (cm_update_annotation (cm_update_v sp ap p fid v st ann phase))
