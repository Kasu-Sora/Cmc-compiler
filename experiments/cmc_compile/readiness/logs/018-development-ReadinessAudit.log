cm_task_statement_control_step
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (task : cm_task) (ann : cm_annotation),
       cm_annotation_erases task ann ->
       cm_task_coordinate_ready (cm_source_function_policy sp) p task ann ->
       cm_task_context_ready task ann ->
       cm_task_statement_control task ann ->
       cm_task_statement_control (cm_step sp task)
         (cm_update_annotation (cm_annotation_step sp ap task ann))
