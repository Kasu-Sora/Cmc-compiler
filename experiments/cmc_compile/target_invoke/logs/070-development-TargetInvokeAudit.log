cm_target_v_phase_step
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (nilslot : cm_slot_d) (p : cm_program) (fid : BinNums.Z)
         (phase : cm_aphase) (v : cm_value) (st : cm_src_state)
         (pc temp b c owner ob oc : BinNums.Z) (tail : list cm_acursor)
         (spills : list cm_spill) (saved : list cm_spill_frame)
         (calls : list cm_call_sim_frame) (target : tvm_task),
       let ann :=
         CMAnnotation pc temp b c (CMACursor phase owner ob oc :: tail)
           spills saved calls in
       cm_semantic_wf_program (cm_source_function_policy sp) p ->
       cm_task_succeeds sp
         (cm_vapply sp p fid (cm_phase_frame phase) v st
            (cm_cursor_frames tail)) ->
       cm_runtime_core (cm_source_function_policy sp) ap p fid st ann ->
       cm_tagged_span_valid st ->
       cm_state_generation_below (cm_source_function_policy sp) p fid st ->
       cm_value_generation_below (cm_state_nextgen st) v ->
       cm_frame_generation_below (cm_source_function_policy sp) p fid
         (cm_state_nextgen st) (cm_phase_frame phase) ->
       cm_spill_frames_generation_below (cm_state_nextgen st)
         (cm_active_spill_frames fid st ann) ->
       cm_frame_fid_ready p fid (cm_phase_frame phase) ->
       cm_phase_budget (cm_source_function_policy sp) p fid phase owner ->
       cm_phase_spill_consistent temp owner phase spills ->
       cm_frame_short_ready st (cm_phase_frame phase) ->
       cm_phase_static_type_ready (cm_source_function_policy sp) nilslot p
         fid phase ->
       cm_phase_value_type_ready (cm_source_function_policy sp) nilslot p fid
         phase v ->
       temp = cm_phase_child_temp phase owner ->
       cm_v_phase_ready sp p v st ann phase ->
       cm_task_layout sp ap p
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) ann ->
       cm_task_target_sim (cm_source_function_policy sp) p
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) target
         ann ->
       cm_target_step_result sp ap p
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) target
         ann
