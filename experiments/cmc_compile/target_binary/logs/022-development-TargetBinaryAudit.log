         (spills : list cm_spill) (saved : list cm_spill_frame)
         (calls : list cm_call_sim_frame) (target : tvm_task),
       let ann :=
         CMAnnotation pc temp b c
           (CMACursor (CABinRP op lhs rhs left ty) owner ob oc :: tail)
           spills saved calls in
       cm_typed_program (cm_source_function_policy sp) p ->
       cm_runtime_core (cm_source_function_policy sp) ap p fid st ann ->
       BinInt.Z.le BinNums.Z0 fid ->
       BinInt.Z.le BinNums.Z0 owner /\
       BinInt.Z.lt owner (cm_temp_slots (cm_source_function_at sp fid p)) ->
       cm_spill_holds owner left spills ->
       op <> BinNums.Z0 ->
       op <> BinNums.Zpos BinNums.xH ->
       cm_binary_types op (cm_expr_type lhs) (cm_expr_type rhs) ty ->
       cm_value_type_compatible left (cm_expr_type lhs) ->
       cm_value_type_compatible v (cm_expr_type rhs) ->
       cm_binary_ok p op left v st = true ->
       cm_task_layout sp ap p
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) ann ->
       cm_task_target_sim (cm_source_function_policy sp) p
         (CMVTask p fid v st (cm_cursor_frames (cm_ann_cursors ann))) target
         ann ->
       cm_target_step_result sp ap p
