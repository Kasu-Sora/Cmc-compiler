cm_machine_call_pending_store
     : forall (sp : cm_source_lookup_policy) (p : cm_program)
         (fid : BinNums.Z) (st : cm_src_state) (vm : tvm_state)
         (calls : list cm_call_sim_frame) (frames : list cm_spill_frame)
         (values : list cm_value) (pc : BinNums.Z),
       let base := cm_state_fp (cm_call_base_state sp p fid st) in
       cm_function_wf (cm_source_function_policy sp) p
         (cm_source_function_at sp fid p) ->
       cm_regions_before (cm_state_regions st) (cm_state_nextgen st) ->
       cm_tags_generation_below (cm_state_nextgen st) (cm_state_tags st) ->
       cm_spill_frames_generation_below (cm_state_nextgen st) frames ->
       cm_tagged_span_valid st ->
       (forall a : BinNums.Z,
        cm_live_address st a ->
        BinInt.Z.lt a base \/
        BinInt.Z.le
          (BinInt.Z.add base
             (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
          a) ->
       (forall a : BinNums.Z,
        cm_live_address st a ->
        BinInt.Z.lt a
          (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) \/
        BinInt.Z.le
          (BinNums.Zpos
             (BinNums.xO (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))))
          a) ->
       cm_call_frames_range_safe
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
         calls ->
       cm_spill_frames_range_safe (cm_source_function_policy sp) p
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
         (BinNums.Zpos (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH))))
         frames ->
       tower_signed64 base ->
       cm_machine_state_sim (cm_source_function_policy sp) p st vm calls
         frames values nil ->
       cm_machine_state_sim (cm_source_function_policy sp) p
         (cm_call_pending_base sp p fid st)
         (TVMState pc
            (cm_encode_values (cm_call_pending_base sp p fid st) values)
            (tvm_calls vm)
            (tower_setw (tvm_mem vm)
               (BinNums.Zpos
                  (BinNums.xO (BinNums.xO (BinNums.xO BinNums.xH)))) base)
            (tvm_input vm) (tvm_output vm)) calls
         (CMSpillFrame fid base nil :: frames) values nil
