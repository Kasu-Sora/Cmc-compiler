cm_tvm_unary
     : forall (obj : tvm_object) (pc value : BinNums.Z)
         (calls : list BinNums.Z) (mem : BinNums.Z -> BinNums.Z)
         (input output : list BinNums.Z) (op : BinNums.Z)
         (rest : list tvm_inst),
       cm_code_at (tvm_object_code obj) pc
         ((TVMInst TVMPushOp
             (if BinInt.Z.eqb op BinNums.Z0
              then BinNums.Zneg BinNums.xH
              else BinNums.Z0)
           :: TVMInst
                (if BinInt.Z.eqb op BinNums.Z0 then TVMMulOp else TVMEqOp)
                BinNums.Z0 :: nil) ++ rest) ->
       tvm_iter 2
         (TVMRunTask obj (TVMState pc (value :: nil) calls mem input output)) =
       TVMRunTask obj
         (TVMState (BinInt.Z.add pc (BinNums.Zpos (BinNums.xO BinNums.xH)))
            ((if BinInt.Z.eqb op BinNums.Z0
              then tower_neg value
              else tower_bool (BinInt.Z.eqb value BinNums.Z0)) :: nil) calls
            mem input output)
