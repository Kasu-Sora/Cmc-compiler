     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (ctl : cm_control)
         (st : cm_src_state) (env : BinNums.Z -> BinNums.Z -> cm_value)
         (regions : list cm_region) (jump : bool)
         (dest pc temp b c owner ob oc : BinNums.Z) 
         (tail : list cm_acursor) (spills : list cm_spill)
         (saved : list cm_spill_frame) (calls : list cm_call_sim_frame)
         (target : tvm_task),
       let ann :=
         CMAnnotation pc temp b c
           (CMACursor (CABlockP env regions jump dest) owner ob oc :: tail)
           spills saved calls in
       cm_semantic_wf_program (cm_source_function_policy sp) p ->
       cm_control_kind ctl <>
       BinNums.Zpos (BinNums.xO (BinNums.xO BinNums.xH)) ->
       List.incl regions (cm_state_regions st) ->
       cm_task_layout sp ap p
         (CMCTask p fid ctl st (cm_cursor_frames (cm_ann_cursors ann))) ann ->
       cm_task_target_sim (cm_source_function_policy sp) p
         (CMCTask p fid ctl st (cm_cursor_frames (cm_ann_cursors ann)))
         target ann ->
       cm_target_step_result sp ap p
         (CMCTask p fid ctl st (cm_cursor_frames (cm_ann_cursors ann)))
         target ann
