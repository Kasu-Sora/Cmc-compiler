cm_load_machine_number
     : forall (policy : cm_lookup_policy) (p : cm_program)
         (st : cm_src_state) (calls : list cm_call_sim_frame)
         (frames : list cm_spill_frame) (ty : cm_type) 
         (ptr : cm_value) (mem : BinNums.Z -> BinNums.Z),
       cm_runtime_memory_layout policy p st calls frames ->
       cm_load_ok ty ptr st = true ->
       cm_scalar_expr_type ty ->
       cm_initialized_bytes_sim st mem ->
       cm_stored_provenance_sim st mem ->
       cm_value_number st (cm_load_value ty ptr st) =
       match ty with
       | CMCharTy => tower_getb mem (cm_value_number st ptr)
       | _ => tower_getw mem (cm_value_number st ptr)
       end
