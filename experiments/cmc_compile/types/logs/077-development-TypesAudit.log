cm_type_enter_call
     : forall (sp : cm_source_lookup_policy) (nilslot : cm_slot_d)
         (p : cm_program) (caller callee : BinNums.Z) 
         (st : cm_src_state) (values : list cm_value) 
         (ret : cm_type) (returnpc temp breakpc continuepc : BinNums.Z)
         (tail : list cm_acursor) (spills : list cm_spill)
         (saved : list cm_spill_frame) (calls : list cm_call_sim_frame),
       cm_typed_program (cm_source_function_policy sp) p ->
       BinInt.Z.le BinNums.Z0 callee /\
       BinInt.Z.lt callee (Zcomplements.Zlength (cm_program_functions p)) ->
       caller = BinNums.Zneg BinNums.xH \/
       BinInt.Z.le BinNums.Z0 caller /\
       BinInt.Z.lt caller (Zcomplements.Zlength (cm_program_functions p)) ->
       ret = cm_function_ret (cm_source_function_at sp callee p) ->
       cm_cursors_type_ready (cm_source_function_policy sp) nilslot p caller
         tail ->
       cm_cursor_head_input_type_ready p caller ret tail ->
       (forall v : cm_value,
        cm_value_type_compatible v ret ->
        cm_cursor_head_value_type_ready (cm_source_function_policy sp)
          nilslot p caller v tail) ->
       cm_task_type_ready (cm_source_function_policy sp) nilslot p
         (CMSTask p callee
            (cm_function_body (cm_source_function_at sp callee p))
            (cm_enter_call sp p callee values st)
            (CMCallK caller (cm_state_env st) (cm_state_fp st)
               (cm_state_regions st) ret :: cm_cursor_frames tail))
         (cm_ann_enter_call sp p caller callee st ret returnpc temp breakpc
            continuepc tail spills saved calls)
