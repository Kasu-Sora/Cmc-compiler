cm_layout_rvalue_linear
     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (expr : cm_expr)
         (st : cm_src_state) (ks : list cm_frame) 
         (ann : cm_annotation) (out : cm_value) (st' : cm_src_state),
       cm_task_layout sp ap p (CMRTask p fid expr st ks) ann ->
       cm_task_layout sp ap p (CMVTask p fid out st' ks)
         (cm_ann_linear
            (cm_emit_rvalue (cm_source_function_policy sp) p fid
               (cm_ann_pc ann) (cm_ann_temp ann) expr) ann)
