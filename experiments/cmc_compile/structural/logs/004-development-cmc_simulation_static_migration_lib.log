  H1 :
    (fix cm_expr_static_valid
       (p : cm_program) (f : cm_function_d) (e : cm_expr) {struct e} :
         Prop :=
       match e with
       | CMStringE sid _ => 0 <= sid < Zlength (cm_program_strings p)
