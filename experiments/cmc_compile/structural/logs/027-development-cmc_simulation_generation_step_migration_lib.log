    (fix cm_frames_generation_below
       (policy : cm_lookup_policy) (p : cm_program) 
       (fid limit : Z) (frames : list cm_frame) {struct frames} : Prop :=
       match frames with
       | [] => fid = -1
       | f :: rest =>
           match f with
           | CMHaltK => fid = -1
           | CMAssignRK v _ | CMBinRK _ v _ | CMIndexRK v _ =>
               cm_value_generation_below limit v
           | CMBlockK env _ | CMWhileBodyK _ _ env _ =>
               cm_env_generation_below policy p fid limit env
           | CMArgK _ _ values _ =>
               (fix cm_values_generation_below
                  (limit0 : Z) (values0 : list cm_value) {struct values0} :
                    Prop :=
                  match values0 with
                  | [] => True
                  | v :: rest1 =>
                      cm_value_generation_below limit0 v /\
                      cm_values_generation_below limit0 rest1
                  end) limit values
           | CMCallK caller env _ _ _ =>
               cm_env_generation_below policy p caller limit env
           | _ => True
           end /\
           cm_frames_generation_below policy p
             match f with
             | CMCallK caller _ _ _ _ => caller
             | _ => fid
             end limit rest
       end) (cm_source_function_policy sp) p fid (cm_state_nextgen st) ks
