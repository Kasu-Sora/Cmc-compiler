     : forall (a : cm_expr) (rest : list cm_expr),
       cm_adepth (cm_args_apair (a :: rest)) =
       BinInt.Z.max (cm_rtemps a) (cm_adepth (cm_args_apair rest)) /\
       BinInt.Z.le BinNums.Z0 (cm_adepth (cm_args_apair rest)) /\
