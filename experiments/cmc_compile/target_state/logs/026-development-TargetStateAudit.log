cm_tvm_short_begin
     : forall (obj : tvm_object) (pc value : BinNums.Z)
         (calls : list BinNums.Z) (mem : BinNums.Z -> BinNums.Z)
         (input output : list BinNums.Z) (is_or : bool) 
         (dest : BinNums.Z) (rest tail : list tvm_inst),
       tvm_targets_valid (tvm_object_code obj) ->
       cm_code_at (tvm_object_code obj) pc
         (TVMInst (if is_or then TVMJnzOp else TVMJzOp) dest :: rest) ->
       cm_code_at (tvm_object_code obj) dest
         (TVMInst TVMPushOp
            (if is_or then BinNums.Zpos BinNums.xH else BinNums.Z0) :: tail) ->
       let short :=
         if is_or
         then negb (BinInt.Z.eqb value BinNums.Z0)
         else BinInt.Z.eqb value BinNums.Z0 in
       tvm_iter (if short then 2 else 1)
         (TVMRunTask obj (TVMState pc (value :: nil) calls mem input output)) =
       TVMRunTask obj
         (TVMState
            (if short
             then BinInt.Z.add dest (BinNums.Zpos BinNums.xH)
             else BinInt.Z.add pc (BinNums.Zpos BinNums.xH))
            (if short
             then
              ((if is_or then BinNums.Zpos BinNums.xH else BinNums.Z0) :: nil)%list
             else nil) calls mem input output)
