     : forall (sp : cm_source_lookup_policy) (ap : cm_annotation_policy)
         (p : cm_program) (fid : BinNums.Z) (v : cm_value)
         (st : cm_src_state) (base : cm_value) (ty : cm_type)
         (pc temp b c owner ob oc : BinNums.Z) (tail : list cm_acursor)
         (spills : list cm_spill) (saved : list cm_spill_frame)
         (calls : list cm_call_sim_frame) (target : tvm_task),
       let ann :=
         CMAnnotation pc temp b c
           (CMACursor (CAIndexRP base ty) owner ob oc :: tail) spills saved
           calls in
