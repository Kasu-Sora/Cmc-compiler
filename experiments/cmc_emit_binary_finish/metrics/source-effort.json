      "text": "PROOF static thm cm_pointer_value_false(const term ty) {\n  return eq_mp_rule(conjunct1_rule(spec_rule(\n      ty, cm_pointer_code_value_cases)), assume_rule(\n        mk_eq(mk_comb(`cm_pointer_code_value`, ty), `0i`)));\n}",
      "dependencies": [],
