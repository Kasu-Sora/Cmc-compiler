      "text": "PROOF static thm cm_pointer_value_true(const term ty) {\n  return eq_mp_rule(conjunct2_rule(spec_rule(\n      ty, cm_pointer_code_value_cases)), assume_rule(\n        mk_not(mk_eq(mk_comb(`cm_pointer_code_value`, ty), `0i`))));\n}",
      "dependencies": [],
      "category": "private_case_proof_support"
    },
