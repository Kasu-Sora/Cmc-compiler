        ],
        "nonblank_lines": 5,
        "text": "PROOF static thm cmc_string_length_model(const term string_model) {\n  return inst_rule(TERM_PAIR_LIST(\n      (term_pair){string_model, `string:cm_string_d`}),\n      get_cm_rep_string_length_def());\n}",
        "dependencies": [],
