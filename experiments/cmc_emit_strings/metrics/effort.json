        "nonblank_lines": 11,
        "text": "PROOF static thm cmc_ilength_nonnegative(void) {\n  gnode root = gnode_new_with_ccl(\n      `!(xs:(int)list). 0i <= ilength xs`);\n  gnode leaf = AUTO_INTROS_TAC(root);\n  thm model = spec_rule(`xs:(int)list`, mk_ilength_of_num_length());\n  thm lifted = beta_norm(ap_term_rule(`\\x:int. 0i <= x`, model));\n  thm positive = spec_rule(`LENGTH (xs:(int)list)`,\n      get_theorem_by_name(\"INT_POS\"));\n  ACCEPT_TAC(leaf, eq_mp_rule(sym_rule(lifted), positive));\n  return gnode_prove(root);\n}",
        "dependencies": [],
        "category": "private_case_proof_support"
      },
      {
        "name": "cmc_ilength_nonnegative_rule",
        "kind": "proof",
        "span": [
          22,
          23
        ],
        "nonblank_lines": 2,
        "text": "PROOF static thm cmc_ilength_nonnegative_rule =\n    cmc_ilength_nonnegative();",
        "dependencies": [
          "cmc_ilength_nonnegative"
        ],
        "category": "private_case_proof_support"
      },
      {
        "name": "cmc_string_length_model",
        "kind": "proof",
        "span": [
          25,
